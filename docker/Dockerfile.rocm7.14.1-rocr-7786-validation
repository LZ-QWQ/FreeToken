FROM crpi-ygzb1jbfyj9pjrm6.cn-shenzhen.personal.cr.aliyuncs.com/images_hana/freetoken:rocm7.14.1-ci-dev1@sha256:65bfbe0c6affc15453abdb2870288c5d1cf8cfd207e9033ca473a982d36bfa77 AS rocr-builder

ARG MAX_JOBS=32
ARG ROCM_SYSTEMS_BASE=ca887ee80abfb82671fe1d6d8da708a713438e05
ARG ROCM_SYSTEMS_FIX=096e6f1b729a7d6f68a1cd333eb565ed382e47ca
ARG ROCM_SYSDEPS=/opt/rocm/core-7.14/lib/rocm_sysdeps

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      cmake pkg-config xxd \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/rocm-systems \
    && git -C /root/rocm-systems init \
    && git -C /root/rocm-systems remote add origin https://github.com/ROCm/rocm-systems.git \
    && git -C /root/rocm-systems sparse-checkout init --cone \
    && git -C /root/rocm-systems sparse-checkout set projects/rocr-runtime \
    && git -C /root/rocm-systems fetch --depth 1 --filter=blob:none origin "${ROCM_SYSTEMS_BASE}" \
    && git -C /root/rocm-systems checkout --detach FETCH_HEAD \
    && test "$(git -C /root/rocm-systems rev-parse HEAD)" = "${ROCM_SYSTEMS_BASE}" \
    && git -C /root/rocm-systems fetch --depth 2 --filter=blob:none origin "${ROCM_SYSTEMS_FIX}" \
    && git -C /root/rocm-systems cherry-pick --no-commit "${ROCM_SYSTEMS_FIX}" \
    && git -C /root/rocm-systems diff --check \
    && PKG_CONFIG_PATH="${ROCM_SYSDEPS}/lib/pkgconfig" cmake \
      -S /root/rocm-systems/projects/rocr-runtime \
      -B /root/rocr-build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_PREFIX_PATH="/opt/rocm;/opt/rocm/llvm" \
      -DCMAKE_INCLUDE_PATH="${ROCM_SYSDEPS}/include" \
      -DCMAKE_LIBRARY_PATH="${ROCM_SYSDEPS}/lib" \
      -DBUILD_SHARED_LIBS=ON \
      -DROCM_PATCH_VERSION=0 \
    && cmake --build /root/rocr-build --target hsa-runtime64 --parallel "${MAX_JOBS}" \
    && test -s /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
    && readelf -d /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
      | grep -q 'librocm_sysdeps_drm.so.2' \
    && readelf -d /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
      | grep -q 'librocm_sysdeps_drm_amdgpu.so.1' \
    && readelf -d /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
      | grep -q 'librocm_sysdeps_elf.so.1' \
    && readelf -d /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
      | grep -q 'librocm_sysdeps_numa.so.1'

FROM crpi-ygzb1jbfyj9pjrm6.cn-shenzhen.personal.cr.aliyuncs.com/images_hana/freetoken:rocm7.14.1-ci-dev1@sha256:65bfbe0c6affc15453abdb2870288c5d1cf8cfd207e9033ca473a982d36bfa77

RUN test "$(readlink -f /opt/rocm/lib/libhsa-runtime64.so.1)" \
      = /opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0 \
    && test -s /opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/libhsa-runtime64.so.1

COPY --from=rocr-builder \
  /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
  /opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0

COPY --from=rocr-builder \
  /root/rocr-build/rocr/lib/libhsa-runtime64.so.1.21.0 \
  /opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/libhsa-runtime64.so.1

RUN test -s /opt/rocm/core-7.14/lib/libhsa-runtime64.so.1.21.0 \
    && test -s /opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/libhsa-runtime64.so.1 \
    && ldconfig \
    && python -c "import torch; assert torch.version.hip == '7.14.60850'; assert torch.version.cuda is None"
